{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "title": "Artifact Path",
          "type": "string"
        },
        "item_count": {
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "nslab.memory_artifact_reference.v1",
          "default": "nslab.memory_artifact_reference.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_path",
        "sha256",
        "item_count"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "PopulationObservedRate": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_iterations": {
          "minimum": 0,
          "title": "Bootstrap Iterations",
          "type": "integer"
        },
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "interval_method": {
          "const": "trade_date_block_bootstrap.v1",
          "default": "trade_date_block_bootstrap.v1",
          "title": "Interval Method",
          "type": "string"
        },
        "lower_bound": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower Bound"
        },
        "metric": {
          "enum": [
            "upper_limit_touched",
            "high_return_5",
            "high_return_10",
            "high_return_20"
          ],
          "title": "Metric",
          "type": "string"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "observed_population_rate": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Population Rate"
        },
        "upper_bound": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper Bound"
        },
        "weighted_denominator": {
          "minimum": 0.0,
          "title": "Weighted Denominator",
          "type": "number"
        },
        "weighted_numerator": {
          "minimum": 0.0,
          "title": "Weighted Numerator",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "numerator",
        "denominator",
        "weighted_numerator",
        "weighted_denominator",
        "bootstrap_iterations"
      ],
      "title": "PopulationObservedRate",
      "type": "object"
    },
    "PopulationOutcomeSummary": {
      "additionalProperties": false,
      "properties": {
        "distribution_weighting": {
          "const": "independent_unit_sample_weight.v1",
          "default": "independent_unit_sample_weight.v1",
          "title": "Distribution Weighting",
          "type": "string"
        },
        "high_return_10_count": {
          "minimum": 0,
          "title": "High Return 10 Count",
          "type": "integer"
        },
        "high_return_20_count": {
          "minimum": 0,
          "title": "High Return 20 Count",
          "type": "integer"
        },
        "high_return_5_count": {
          "minimum": 0,
          "title": "High Return 5 Count",
          "type": "integer"
        },
        "mean_close_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Close Return Pct"
        },
        "mean_high_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean High Return Pct"
        },
        "median_close_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median Close Return Pct"
        },
        "median_high_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median High Return Pct"
        },
        "missing_outcome_unit_count": {
          "minimum": 0,
          "title": "Missing Outcome Unit Count",
          "type": "integer"
        },
        "observed_unit_count": {
          "minimum": 0,
          "title": "Observed Unit Count",
          "type": "integer"
        },
        "p10_close_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P10 Close Return Pct"
        },
        "p10_high_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P10 High Return Pct"
        },
        "p25_close_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P25 Close Return Pct"
        },
        "p25_high_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P25 High Return Pct"
        },
        "p75_close_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P75 Close Return Pct"
        },
        "p75_high_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P75 High Return Pct"
        },
        "p90_close_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P90 Close Return Pct"
        },
        "p90_high_return_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "P90 High Return Pct"
        },
        "upper_limit_touched_count": {
          "minimum": 0,
          "title": "Upper Limit Touched Count",
          "type": "integer"
        }
      },
      "required": [
        "observed_unit_count",
        "missing_outcome_unit_count",
        "upper_limit_touched_count",
        "high_return_5_count",
        "high_return_10_count",
        "high_return_20_count"
      ],
      "title": "PopulationOutcomeSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bootstrap_version": {
      "const": "trade_date_block_bootstrap.v1",
      "default": "trade_date_block_bootstrap.v1",
      "title": "Bootstrap Version",
      "type": "string"
    },
    "cluster_id": {
      "title": "Cluster Id",
      "type": "string"
    },
    "corpus_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Manifest Sha256",
      "type": "string"
    },
    "cube_rows": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "cube_version": {
      "title": "Cube Version",
      "type": "string"
    },
    "cutoff_at": {
      "format": "date-time",
      "title": "Cutoff At",
      "type": "string"
    },
    "effective_sample_size": {
      "minimum": 0.0,
      "title": "Effective Sample Size",
      "type": "number"
    },
    "eligibility_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Eligibility Counts",
      "type": "object"
    },
    "included_memory_lanes": {
      "items": {
        "type": "string"
      },
      "title": "Included Memory Lanes",
      "type": "array"
    },
    "independent_unit_count": {
      "minimum": 0,
      "title": "Independent Unit Count",
      "type": "integer"
    },
    "independent_unit_type": {
      "enum": [
        "event-issuer-day",
        "issuer-day",
        "theme-day",
        "theme-day-ticker-day",
        "theme-day-pair",
        "ticker-day"
      ],
      "title": "Independent Unit Type",
      "type": "string"
    },
    "independent_units": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "label_quality_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Label Quality Counts",
      "type": "object"
    },
    "max_cube_row_count": {
      "minimum": 1,
      "title": "Max Cube Row Count",
      "type": "integer"
    },
    "max_selected_record_count": {
      "minimum": 1,
      "title": "Max Selected Record Count",
      "type": "integer"
    },
    "member_records": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "membership_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Membership Manifest Sha256",
      "type": "string"
    },
    "memory_snapshot_id": {
      "title": "Memory Snapshot Id",
      "type": "string"
    },
    "observed_population_rate_label": {
      "const": "observed_population_rate",
      "default": "observed_population_rate",
      "title": "Observed Population Rate Label",
      "type": "string"
    },
    "observed_rates": {
      "items": {
        "$ref": "#/$defs/PopulationObservedRate"
      },
      "title": "Observed Rates",
      "type": "array"
    },
    "outcome_summary": {
      "$ref": "#/$defs/PopulationOutcomeSummary"
    },
    "polarity_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Polarity Counts",
      "type": "object"
    },
    "population_id": {
      "title": "Population Id",
      "type": "string"
    },
    "population_purpose": {
      "enum": [
        "catalyst_response",
        "candidate_error",
        "newsless",
        "leader_selection"
      ],
      "title": "Population Purpose",
      "type": "string"
    },
    "purpose_classifier_version": {
      "title": "Purpose Classifier Version",
      "type": "string"
    },
    "purpose_record_types_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Purpose Record Types Sha256",
      "type": "string"
    },
    "query_regime_cluster": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Query Regime Cluster"
    },
    "raw_record_count": {
      "minimum": 0,
      "title": "Raw Record Count",
      "type": "integer"
    },
    "regime_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Regime Counts",
      "type": "object"
    },
    "routing_dispositions": {
      "items": {
        "enum": [
          "REASONING",
          "CONTEXT",
          "AUDIT",
          "QUARANTINED"
        ],
        "type": "string"
      },
      "title": "Routing Dispositions",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "nslab.population_manifest.v2",
      "default": "nslab.population_manifest.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_cell_ids": {
      "items": {
        "type": "string"
      },
      "title": "Selected Cell Ids",
      "type": "array"
    },
    "selection_budget_version": {
      "title": "Selection Budget Version",
      "type": "string"
    },
    "source_generation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Generation Sha256",
      "type": "string"
    },
    "statistics_version": {
      "title": "Statistics Version",
      "type": "string"
    },
    "time_slice_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Time Slice Counts",
      "type": "object"
    }
  },
  "required": [
    "population_id",
    "run_id",
    "cluster_id",
    "cutoff_at",
    "memory_snapshot_id",
    "source_generation_sha256",
    "corpus_manifest_sha256",
    "statistics_version",
    "cube_version",
    "selection_budget_version",
    "purpose_classifier_version",
    "purpose_record_types_sha256",
    "max_selected_record_count",
    "max_cube_row_count",
    "membership_manifest_sha256",
    "independent_unit_type",
    "population_purpose",
    "raw_record_count",
    "independent_unit_count",
    "effective_sample_size",
    "outcome_summary",
    "member_records",
    "independent_units",
    "cube_rows"
  ],
  "title": "PopulationManifest",
  "type": "object"
}
