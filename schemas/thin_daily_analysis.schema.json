        "cutoff_at": {
          "format": "date-time",
          "title": "Cutoff At",
          "type": "string"
        },
        "dominant_sectors": {
          "items": {
            "$ref": "#/$defs/DominantSectorHypothesis"
          },
          "title": "Dominant Sectors",
          "type": "array"
