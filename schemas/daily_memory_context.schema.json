{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "title": "Artifact Path",
          "type": "string"
        },
        "item_count": {
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "nslab.memory_artifact_reference.v1",
          "default": "nslab.memory_artifact_reference.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_path",
        "sha256",
        "item_count"
      ],
      "title": "ArtifactReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "adaptive_retrieval_traces": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Adaptive Retrieval Traces",
      "type": "array"
    },
    "category_brain_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category Brain Manifest Sha256"
    },
    "context_complete": {
      "title": "Context Complete",
      "type": "boolean"
    },
    "contradicting_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Contradicting Record Ids",
      "type": "array"
    },
    "corpus_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Manifest Sha256",
      "type": "string"
    },
    "cutoff_at": {
      "format": "date-time",
      "title": "Cutoff At",
      "type": "string"
    },
    "estimated_token_count": {
      "minimum": 0,
      "title": "Estimated Token Count",
      "type": "integer"
    },
    "event_cluster_manifest": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "memory_coverage_manifest": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "news_coverage_manifest": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "population_manifests": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Population Manifests",
      "type": "array"
    },
    "representative_set_manifests": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "title": "Representative Set Manifests",
      "type": "array"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "nslab.daily_memory_context.v1",
      "default": "nslab.daily_memory_context.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "supporting_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Supporting Record Ids",
      "type": "array"
    },
    "trade_date": {
      "format": "date",
      "title": "Trade Date",
      "type": "string"
    },
    "unexplained_record_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unexplained Record Ids",
      "type": "array"
    },
    "unresolved_disagreements": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Disagreements",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "trade_date",
    "cutoff_at",
    "corpus_manifest_sha256",
    "news_coverage_manifest",
    "event_cluster_manifest",
    "memory_coverage_manifest",
    "estimated_token_count",
    "context_complete"
  ],
  "title": "DailyMemoryContext",
  "type": "object"
}
