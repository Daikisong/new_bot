{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "title": "Artifact Path",
          "type": "string"
        },
        "item_count": {
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "nslab.memory_artifact_reference.v1",
          "default": "nslab.memory_artifact_reference.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_path",
        "sha256",
        "item_count"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "BeneficiaryGraphPath": {
      "additionalProperties": false,
      "properties": {
        "business_roles": {
          "items": {
            "type": "string"
          },
          "title": "Business Roles",
          "type": "array"
        },
        "candidate_path_type": {
          "title": "Candidate Path Type",
          "type": "string"
        },
        "candidate_rank": {
          "minimum": 1,
          "title": "Candidate Rank",
          "type": "integer"
        },
        "company_memory_artifact_paths": {
          "items": {
            "type": "string"
          },
          "title": "Company Memory Artifact Paths",
          "type": "array"
        },
        "company_name": {
          "title": "Company Name",
          "type": "string"
        },
        "event_cluster_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Cluster Ids",
          "type": "array"
        },
        "mechanism_steps": {
          "items": {
            "type": "string"
          },
          "title": "Mechanism Steps",
          "type": "array"
        },
        "narrative_context": {
          "items": {
            "type": "string"
          },
          "title": "Narrative Context",
          "type": "array"
        },
        "path_id": {
          "title": "Path Id",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "status": {
          "const": "OPEN_WORLD_CANDIDATE_REQUIRES_VERIFICATION",
          "default": "OPEN_WORLD_CANDIDATE_REQUIRES_VERIFICATION",
          "title": "Status",
          "type": "string"
        },
        "ticker": {
          "title": "Ticker",
          "type": "string"
        }
      },
      "required": [
        "path_id",
        "ticker",
        "company_name",
        "candidate_rank",
        "candidate_path_type"
      ],
      "title": "BeneficiaryGraphPath",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_count": {
      "minimum": 0,
      "title": "Candidate Count",
      "type": "integer"
    },
    "candidate_input_artifact": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "candidate_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Input Sha256",
      "type": "string"
    },
    "company_memory_artifact_sha256s": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Company Memory Artifact Sha256S",
      "type": "object"
    },
    "cutoff_at": {
      "format": "date-time",
      "title": "Cutoff At",
      "type": "string"
    },
    "event_cluster_manifest": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "excluded_company_memory_artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Company Memory Artifact Paths",
      "type": "array"
    },
    "path_count": {
      "minimum": 0,
      "title": "Path Count",
      "type": "integer"
    },
    "paths": {
      "items": {
        "$ref": "#/$defs/BeneficiaryGraphPath"
      },
      "title": "Paths",
      "type": "array"
    },
    "reviewed_company_memory_count": {
      "minimum": 0,
      "title": "Reviewed Company Memory Count",
      "type": "integer"
    },
    "reviewed_company_memory_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reviewed Company Memory Root Sha256",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "nslab.beneficiary_graph.v2",
      "default": "nslab.beneficiary_graph.v2",
      "title": "Schema Version",
      "type": "string"
    },
    "unmatched_company_memory_count": {
      "minimum": 0,
      "title": "Unmatched Company Memory Count",
      "type": "integer"
    },
    "unresolved_candidate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Candidate Ids",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "cutoff_at",
    "event_cluster_manifest",
    "reviewed_company_memory_count",
    "reviewed_company_memory_root_sha256",
    "unmatched_company_memory_count",
    "candidate_input_artifact",
    "candidate_input_sha256",
    "candidate_count",
    "path_count"
  ],
  "title": "BeneficiaryGraphArtifact",
  "type": "object"
}
