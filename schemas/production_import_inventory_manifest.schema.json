{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "title": "Artifact Path",
          "type": "string"
        },
        "item_count": {
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "nslab.memory_artifact_reference.v1",
          "default": "nslab.memory_artifact_reference.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_path",
        "sha256",
        "item_count"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "ProductionInventoryAttestation": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "HMAC-SHA256",
          "default": "HMAC-SHA256",
          "title": "Algorithm",
          "type": "string"
        },
        "commitment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Commitment Sha256",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[0-9a-f]{16}$",
          "title": "Key Id",
          "type": "string"
        },
        "schema_version": {
          "const": "nslab.production_inventory_attestation.v1",
          "default": "nslab.production_inventory_attestation.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "signature": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "issued_at",
        "key_id",
        "commitment_sha256",
        "signature"
      ],
      "title": "ProductionInventoryAttestation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attestation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductionInventoryAttestation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "declared_ready_bundle_count": {
      "minimum": 0,
      "title": "Declared Ready Bundle Count",
      "type": "integer"
    },
    "deep_hash_verified": {
      "title": "Deep Hash Verified",
      "type": "boolean"
    },
    "finding_count": {
      "minimum": 0,
      "title": "Finding Count",
      "type": "integer"
    },
    "findings": {
      "items": {
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "inventory_id": {
      "pattern": "^P9INV-[0-9A-F]{20}$",
      "title": "Inventory Id",
      "type": "string"
    },
    "manifest_entry_count": {
      "minimum": 0,
      "title": "Manifest Entry Count",
      "type": "integer"
    },
    "quality_gate_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Quality Gate Root Sha256",
      "type": "string"
    },
    "ready_bundle_count": {
      "minimum": 0,
      "title": "Ready Bundle Count",
      "type": "integer"
    },
    "ready_entries": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "ready_for_import": {
      "title": "Ready For Import",
      "type": "boolean"
    },
    "ready_record_count": {
      "minimum": 0,
      "title": "Ready Record Count",
      "type": "integer"
    },
    "ready_semantic_excluded_record_count": {
      "minimum": 0,
      "title": "Ready Semantic Excluded Record Count",
      "type": "integer"
    },
    "ready_training_eligible_record_count": {
      "minimum": 0,
      "title": "Ready Training Eligible Record Count",
      "type": "integer"
    },
    "repaired_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Repaired Root Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "nslab.production_import_inventory_manifest.v1",
      "default": "nslab.production_import_inventory_manifest.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_manifest": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "source_root_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Root Sha256",
      "type": "string"
    },
    "status_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Status Counts",
      "type": "object"
    },
    "verifier_version": {
      "const": "production_import_inventory.v1",
      "default": "production_import_inventory.v1",
      "title": "Verifier Version",
      "type": "string"
    }
  },
  "required": [
    "inventory_id",
    "created_at",
    "source_manifest",
    "ready_entries",
    "manifest_entry_count",
    "status_counts",
    "declared_ready_bundle_count",
    "ready_bundle_count",
    "ready_record_count",
    "ready_training_eligible_record_count",
    "ready_semantic_excluded_record_count",
    "source_root_sha256",
    "repaired_root_sha256",
    "quality_gate_root_sha256",
    "deep_hash_verified",
    "ready_for_import",
    "finding_count"
  ],
  "title": "ProductionImportInventoryManifest",
  "type": "object"
}
