{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {
          "title": "Artifact Path",
          "type": "string"
        },
        "item_count": {
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "nslab.memory_artifact_reference.v1",
          "default": "nslab.memory_artifact_reference.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_path",
        "sha256",
        "item_count"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "NumericDistribution": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "maximum": {
          "minimum": 0.0,
          "title": "Maximum",
          "type": "number"
        },
        "mean": {
          "minimum": 0.0,
          "title": "Mean",
          "type": "number"
        },
        "minimum": {
          "minimum": 0.0,
          "title": "Minimum",
          "type": "number"
        },
        "p50": {
          "minimum": 0.0,
          "title": "P50",
          "type": "number"
        },
        "p95": {
          "minimum": 0.0,
          "title": "P95",
          "type": "number"
        },
        "p99": {
          "minimum": 0.0,
          "title": "P99",
          "type": "number"
        }
      },
      "required": [
        "count",
        "minimum",
        "mean",
        "p50",
        "p95",
        "p99",
        "maximum"
      ],
      "title": "NumericDistribution",
      "type": "object"
    },
    "ShadowArmMetrics": {
      "additionalProperties": false,
      "properties": {
        "arm_id": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E",
            "F"
          ],
          "title": "Arm Id",
          "type": "string"
        },
        "brier_score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brier Score"
        },
        "cache_hit_rate": {
          "$ref": "#/$defs/ShadowRate"
        },
        "calibration_coverage": {
          "$ref": "#/$defs/ShadowRate"
        },
        "candidate_recall_at_10": {
          "$ref": "#/$defs/ShadowRate"
        },
        "candidate_recall_at_20": {
          "$ref": "#/$defs/ShadowRate"
        },
        "candidate_recall_at_5": {
          "$ref": "#/$defs/ShadowRate"
        },
        "counterexample_inclusion_rate": {
          "$ref": "#/$defs/ShadowRate"
        },
        "daily_analysis_latency_ms": {
          "$ref": "#/$defs/NumericDistribution"
        },
        "embedding_query_count": {
          "$ref": "#/$defs/NumericDistribution"
        },
        "estimated_cost_usd": {
          "minimum": 0.0,
          "title": "Estimated Cost Usd",
          "type": "number"
        },
        "expected_calibration_error": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Calibration Error"
        },
        "false_positive_rate": {
          "$ref": "#/$defs/ShadowRate"
        },
        "high_10_recall": {
          "$ref": "#/$defs/ShadowRate"
        },
        "high_20_recall": {
          "$ref": "#/$defs/ShadowRate"
        },
        "holdout_case_count": {
          "minimum": 0,
          "title": "Holdout Case Count",
          "type": "integer"
        },
        "issuer_day_duplicate_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Issuer Day Duplicate Rate",
          "type": "number"
        },
        "known_relevant_record_recall": {
          "$ref": "#/$defs/ShadowRate"
        },
        "leader_error_rate": {
          "$ref": "#/$defs/ShadowRate"
        },
        "llm_input_tokens": {
          "$ref": "#/$defs/NumericDistribution"
        },
        "llm_output_tokens": {
          "$ref": "#/$defs/NumericDistribution"
        },
        "long_tail_beneficiary_recall": {
          "$ref": "#/$defs/ShadowRate"
        },
        "negative_control_inclusion_rate": {
          "$ref": "#/$defs/ShadowRate"
        },
        "newsless_hallucination_rate": {
          "$ref": "#/$defs/ShadowRate"
        },
        "online_full_scan_count": {
          "minimum": 0,
          "title": "Online Full Scan Count",
          "type": "integer"
        },
        "peak_memory_bytes": {
          "minimum": 0,
          "title": "Peak Memory Bytes",
          "type": "integer"
        },
        "pre_llm_latency_ms": {
          "$ref": "#/$defs/NumericDistribution"
        },
        "theme_over_expansion_rate": {
          "$ref": "#/$defs/ShadowRate"
        },
        "unique_regime_count": {
          "minimum": 0,
          "title": "Unique Regime Count",
          "type": "integer"
        },
        "unique_year_count": {
          "minimum": 0,
          "title": "Unique Year Count",
          "type": "integer"
        }
      },
      "required": [
        "arm_id",
        "holdout_case_count",
        "candidate_recall_at_5",
        "candidate_recall_at_10",
        "candidate_recall_at_20",
        "high_10_recall",
        "high_20_recall",
        "false_positive_rate",
        "leader_error_rate",
        "theme_over_expansion_rate",
        "newsless_hallucination_rate",
        "known_relevant_record_recall",
        "negative_control_inclusion_rate",
        "counterexample_inclusion_rate",
        "long_tail_beneficiary_recall",
        "issuer_day_duplicate_rate",
        "unique_year_count",
        "unique_regime_count",
        "calibration_coverage",
        "pre_llm_latency_ms",
        "daily_analysis_latency_ms",
        "llm_input_tokens",
        "llm_output_tokens",
        "embedding_query_count",
        "cache_hit_rate",
        "peak_memory_bytes",
        "estimated_cost_usd",
        "online_full_scan_count"
      ],
      "title": "ShadowArmMetrics",
      "type": "object"
    },
    "ShadowBiasAudit": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Checks",
          "type": "object"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "schema_version": {
          "const": "nslab.shadow_bias_audit.v1",
          "default": "nslab.shadow_bias_audit.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "checks",
        "passed"
      ],
      "title": "ShadowBiasAudit",
      "type": "object"
    },
    "ShadowExitGate": {
      "additionalProperties": false,
      "properties": {
        "blockers": {
          "items": {
            "type": "string"
          },
          "title": "Blockers",
          "type": "array"
        },
        "checks": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Checks",
          "type": "object"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "checks",
        "passed"
      ],
      "title": "ShadowExitGate",
      "type": "object"
    },
    "ShadowLoadAttestation": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "HMAC-SHA256",
          "default": "HMAC-SHA256",
          "title": "Algorithm",
          "type": "string"
        },
        "commitment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Commitment Sha256",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[0-9a-f]{16}$",
          "title": "Key Id",
          "type": "string"
        },
        "schema_version": {
          "const": "nslab.shadow_load_attestation.v1",
          "default": "nslab.shadow_load_attestation.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "signature": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "issued_at",
        "key_id",
        "commitment_sha256",
        "signature"
      ],
      "title": "ShadowLoadAttestation",
      "type": "object"
    },
    "ShadowLoadProfile": {
      "additionalProperties": false,
      "properties": {
        "blocker_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker Reason"
        },
        "corpus_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus Manifest Sha256"
        },
        "daily_analysis_latency_ms": {
          "$ref": "#/$defs/NumericDistribution"
        },
        "daily_analysis_latency_samples_ms": {
          "items": {
            "type": "number"
          },
          "title": "Daily Analysis Latency Samples Ms",
          "type": "array"
        },
        "embedding_dimensions": {
          "minimum": 0,
          "title": "Embedding Dimensions",
          "type": "integer"
        },
        "embedding_model": {
          "title": "Embedding Model",
          "type": "string"
        },
        "embedding_provider": {
          "title": "Embedding Provider",
          "type": "string"
        },
        "load_attestation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShadowLoadAttestation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "measured": {
          "title": "Measured",
          "type": "boolean"
        },
        "online_full_scan_count": {
          "minimum": 0,
          "title": "Online Full Scan Count",
          "type": "integer"
        },
        "online_full_scan_samples": {
          "items": {
            "type": "integer"
          },
          "title": "Online Full Scan Samples",
          "type": "array"
        },
        "peak_memory_bytes": {
          "minimum": 0,
          "title": "Peak Memory Bytes",
          "type": "integer"
        },
        "peak_memory_samples_bytes": {
          "items": {
            "type": "integer"
          },
          "title": "Peak Memory Samples Bytes",
          "type": "array"
        },
        "pre_llm_latency_ms": {
          "$ref": "#/$defs/NumericDistribution"
        },
        "pre_llm_latency_samples_ms": {
          "items": {
            "type": "number"
          },
          "title": "Pre Llm Latency Samples Ms",
          "type": "array"
        },
        "production_shape": {
          "title": "Production Shape",
          "type": "boolean"
        },
        "profile_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profiler_version": {
          "title": "Profiler Version",
          "type": "string"
        },
        "real_embedding_provider": {
          "title": "Real Embedding Provider",
          "type": "boolean"
        },
        "record_count": {
          "enum": [
            50000,
            200000,
            600000
          ],
          "title": "Record Count",
          "type": "integer"
        },
        "sample_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactReference"
          },
          "title": "Sample Artifacts",
          "type": "array"
        },
        "sample_completed_at": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Sample Completed At",
          "type": "array"
        },
        "sample_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Sample Run Ids",
          "type": "array"
        },
        "sample_started_at": {
          "items": {
            "format": "date-time",
            "type": "string"
          },
          "title": "Sample Started At",
          "type": "array"
        },
        "source_generation_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Generation Sha256"
        },
        "source_snapshot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Snapshot Id"
        },
        "source_snapshot_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workload_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactReference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "workload_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Sha256"
        }
      },
      "required": [
        "record_count",
        "measured",
        "production_shape",
        "real_embedding_provider",
        "embedding_dimensions",
        "embedding_provider",
        "embedding_model",
        "profiler_version",
        "pre_llm_latency_ms",
        "daily_analysis_latency_ms",
        "peak_memory_bytes",
        "online_full_scan_count"
      ],
      "title": "ShadowLoadProfile",
      "type": "object"
    },
    "ShadowRate": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "ShadowRate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "arm_metrics": {
      "items": {
        "$ref": "#/$defs/ShadowArmMetrics"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Arm Metrics",
      "type": "array"
    },
    "bias_audit": {
      "$ref": "#/$defs/ShadowBiasAudit"
    },
    "bias_audit_version": {
      "title": "Bias Audit Version",
      "type": "string"
    },
    "blind_web_call_count": {
      "const": 0,
      "default": 0,
      "title": "Blind Web Call Count",
      "type": "integer"
    },
    "calibration_buckets": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "calibration_case_count": {
      "minimum": 0,
      "title": "Calibration Case Count",
      "type": "integer"
    },
    "calibration_version": {
      "title": "Calibration Version",
      "type": "string"
    },
    "case_results": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Sha256",
      "type": "string"
    },
    "evaluation_id": {
      "title": "Evaluation Id",
      "type": "string"
    },
    "evidence_policy": {
      "const": "csv-memory-only-strict",
      "default": "csv-memory-only-strict",
      "title": "Evidence Policy",
      "type": "string"
    },
    "exit_gate": {
      "$ref": "#/$defs/ShadowExitGate"
    },
    "external_web_evidence_count": {
      "const": 0,
      "default": 0,
      "title": "External Web Evidence Count",
      "type": "integer"
    },
    "holdout_case_count": {
      "minimum": 0,
      "title": "Holdout Case Count",
      "type": "integer"
    },
    "load_profiles": {
      "items": {
        "$ref": "#/$defs/ShadowLoadProfile"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Load Profiles",
      "type": "array"
    },
    "metric_version": {
      "title": "Metric Version",
      "type": "string"
    },
    "production_ready": {
      "title": "Production Ready",
      "type": "boolean"
    },
    "protocol_version": {
      "title": "Protocol Version",
      "type": "string"
    },
    "schema_version": {
      "const": "nslab.shadow_evaluation_manifest.v1",
      "default": "nslab.shadow_evaluation_manifest.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_dataset": {
      "$ref": "#/$defs/ArtifactReference"
    },
    "system_budget_version": {
      "title": "System Budget Version",
      "type": "string"
    },
    "web_provider": {
      "const": "disabled",
      "default": "disabled",
      "title": "Web Provider",
      "type": "string"
    },
    "web_required": {
      "const": false,
      "default": false,
      "title": "Web Required",
      "type": "boolean"
    }
  },
  "required": [
    "evaluation_id",
    "created_at",
    "dataset_id",
    "dataset_sha256",
    "protocol_version",
    "metric_version",
    "calibration_version",
    "bias_audit_version",
    "system_budget_version",
    "calibration_case_count",
    "holdout_case_count",
    "arm_metrics",
    "calibration_buckets",
    "case_results",
    "source_dataset",
    "bias_audit",
    "load_profiles",
    "exit_gate",
    "production_ready"
  ],
  "title": "ShadowEvaluationManifest",
  "type": "object"
}
